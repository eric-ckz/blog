# 首次启动时用于创建唯一管理员。请勿将真实密码提交到 Git。
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=change-me-with-a-strong-password
BLOG_ADMIN_DISPLAY_NAME=博客管理员

# 至少 32 个字符；生产环境应使用随机生成的高强度密钥。
BLOG_JWT_SECRET=replace-with-at-least-32-random-characters

# MySQL 数据库配置。开发环境默认连接本机 blog 数据库，也可用这些变量覆盖。
BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/blog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=change-me

# 上传目录建议在生产环境使用绝对路径；本地留空时默认使用 blog-server/uploads。
BLOG_STORAGE_ROOT=D:/path/to/blog-server/uploads

# 逗号分隔的管理端允许来源。
BLOG_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
