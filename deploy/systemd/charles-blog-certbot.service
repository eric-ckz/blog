[Unit]
Description=Renew the Charles Blog Let's Encrypt certificate
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Certbot writes only the persistent certificate directory. Nginx receives HUP only after a successful renewal check.
ExecStart=/bin/sh -c '/usr/bin/docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/charles-blog/certbot-www:/var/www/certbot certbot/certbot:v2.11.0 renew --webroot -w /var/www/certbot --quiet && /usr/bin/docker kill -s HUP charles-blog-nginx'
